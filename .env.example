1. Copy this file:  cp .env.example .env
# 2. Fill in real values (never commit .env)
# 3. On Vercel: Project → Settings → Environment Variables
# =============================================================================
# Required: PostgreSQL connection string
# Local example:
# DATABASE_URL=postgresql://neondb_owner:npg_EmeoOPTkq39j@ep-bold-frost-aybncj6w.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
#
# Vercel + Neon / Supabase / Vercel Postgres example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
# Required in production: long random secret for JWT session cookies
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-long-random-string
# Public site URL (used for SEO metadata, Open Graph, sharing)
# Local:  http://localhost:3000
# Vercel: https://your-project.vercel.app  (or your custom domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: override default admin seed (created automatically on first boot)
# Default demo login if unset in seed: admin@northpole.app / admin123
# ADMIN_EMAIL=admin@northpole.app
# ADMIN_PASSWORD=change-this-strong-password
